# Optional overrides. Defaults are documented in the README.

BOT_TOKEN_VISHNU=kiwi_vishnu_k9m2XqP4wR7nT1bH8sL3
BOT_TOKEN_FRIEND=kiwi_friend_p5Yc8Nm2qK4wJ9tR6vA1

# Human logins (no public signup). Give these to Vishnu and his friend.
LOGIN_VISHNU=vishnu
PASSWORD_VISHNU=kiwi_vishnu_login
LOGIN_FRIEND=friend
PASSWORD_FRIEND=kiwi_friend_login

# Optional. If unset, a secret is derived from the bot tokens.
# SESSION_SECRET=change-me

# Dropbox OAuth (friend profile → Connect Dropbox).
# Create an app at https://www.dropbox.com/developers/apps
# Redirect URI must match exactly, e.g.:
#   http://localhost:3000/api/dropbox/callback
#   https://<your-app>.vercel.app/api/dropbox/callback
# Enable at least account_info.read (files scopes optional).
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# DROPBOX_REDIRECT_URI=http://localhost:3000/api/dropbox/callback

# Convex project: kiwi-chat
# Dev deployment: flippant-swan-205
# Dashboard: https://dashboard.convex.dev/t/vishnu-satyavarapu/kiwi-chat/flippant-swan-205
NEXT_PUBLIC_CONVEX_URL=https://flippant-swan-205.convex.cloud
CONVEX_URL=https://flippant-swan-205.convex.cloud
CONVEX_DEPLOYMENT=dev:flippant-swan-205
# Create under Convex dashboard → Settings → Deploy Keys. Do not invent this.
# CONVEX_DEPLOY_KEY=
# Force local SQLite even when the Convex URL is set:
# KIWI_USE_SQLITE=1

# Local SQLite fallback when Convex is unset: ./data/kiwi.db
# On Vercel without Convex: /tmp/kiwi-chat.db unless KIWI_DB_PATH is set
# KIWI_DB_PATH=/absolute/path/to/kiwi.db

# Set to 0 to hide bot tokens in Vishnu’s sidebar.
# KIWI_SHOW_TOKENS=1

# Kiwi Lead / Friend Grok wake webhooks (fire-and-forget after new messages).
# Paste the Grok Bot routine webhook URL here (Vercel → Environment Variables).
# KIWI_CTO_WEBHOOK_URL=https://...
# Optional shared secret sent as Authorization: Bearer, X-Kiwi-Webhook-Secret,
# and X-Kiwi-Sender-Key:
# KIWI_CTO_WEBHOOK_SECRET=
# Same pattern for the friend’s Grok (optional):
# KIWI_FRIEND_WEBHOOK_URL=
# KIWI_FRIEND_WEBHOOK_SECRET=
